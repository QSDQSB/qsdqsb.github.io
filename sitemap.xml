---
layout: none
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {%- comment -%}
    Image entries: every photograph of a voyage, from its merged manifest
    (_data/photo_manifests/, written by `npm run photos:fetch`), at the 1920 px
    JPEG on img.qsdqsb.com, captioned with its place. lastmod comes from
    jekyll-last-modified-at (real git dates — CI checks out with full
    history), falling back to the publish date.
  {%- endcomment -%}
  <url>
    <loc>{{ site.url }}/year-archive/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/tags/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/categories/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/terms/</loc>
  </url>
  {% for post in site.posts %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
      <lastmod>{{ post.last_modified_at | default: post.date | date: "%Y-%m-%d" }}</lastmod>
    </url>
  {% endfor %}
  <url>
    <loc>{{ site.url }}/portfolio/</loc>
  </url>
  {% for post in site.portfolio %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
      <lastmod>{{ post.last_modified_at | default: post.date | date: "%Y-%m-%d" }}</lastmod>
    </url>
  {% endfor %}
  <url>
    <loc>{{ site.url }}/voyage-by-tags/</loc>
  </url>
  {% assign gallery_pages = site.voyage | concat: site.subvoyage %}
  {% for post in gallery_pages %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
      <lastmod>{{ post.last_modified_at | default: post.date | date: "%Y-%m-%d" }}</lastmod>
      {%- if post.gallery_name %}
        {%- assign sitemap_key = post.gallery_name | replace: "/", "_" %}
        {%- assign sitemap_book = site.data.photo_manifests[sitemap_key] %}
        {%- for photo in sitemap_book.photos %}
          {%- assign photo_jpg = photo.sizes.jpg | where_exp: "w", "w <= 1920" | last | default: photo.sizes.jpg.first %}
      <image:image>
        <image:loc>{{ photo.url }}/{{ photo_jpg }}.jpg</image:loc>
        {%- assign photo_title = photo.place.name | default: photo.caption %}
        {%- if photo_title %}
        <image:title>{{ photo_title | xml_escape }}</image:title>
        {%- endif %}
      </image:image>
        {%- endfor %}
      {%- endif %}
    </url>
  {% endfor %}
  <url>
    <loc>{{ site.url }}</loc>
  </url>
  <url>
    <loc>{{ site.url }}/cv/</loc>
  </url>
</urlset>

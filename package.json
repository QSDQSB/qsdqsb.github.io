{
  "name": "qsdqsb-github-blog",
  "version": "0.9.7",
  "description": "QSD'S personal version of Minimal Mistake Jekyll theme.",
  "repository": {
    "type": "git",
    "url": "git://github.com/qsdqsb/qsdqsb.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "author": "QSD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qsdqsb/qsdqsb.github.io/issues"
  },
  "homepage": "https://qsdqsb.github.io/qsdqsb.github.io/",
  "engines": {
    "node": ">= 18.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@xenova/transformers": "^2.17.2",
    "exifr": "^7.1.3",
    "npm-run-all": "^1.7.0",
    "onchange": "^7.1.0",
    "piexifjs": "^1.0.6",
    "sharp": "^0.34.5",
    "terser": "^5.43.1",
    "thumbhash": "^0.1.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "uglify": "terser assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify",
    "check:responsive-policy": "bash scripts/check-responsive-policy.sh",
    "check:seo": "python3 scripts/check-seo-descriptions.py",
    "geocode": "node scripts/geocode-maps.js",
    "generate:gallery": "node scripts/generate-gallery-assets.mjs",
    "generate:depth": "node scripts/generate-hero-depth-maps.mjs",
    "generate:gallery:lqip": "node scripts/generate-gallery-assets.mjs --lqip-only",
    "photos:push": "node scripts/photos/push.mjs",
    "photos:plan": "node scripts/photos/plan.mjs",
    "photos:prune": "node scripts/photos/prune.mjs",
    "photos:process": "node scripts/photos/process.mjs",
    "photos:fetch": "node scripts/photos/fetch-manifests.mjs --quiet",
    "photos:bootstrap": "node scripts/photos/bootstrap.mjs",
    "build": "npm run generate:gallery && npm run photos:fetch && npm run geocode && RUBYOPT=\"-E utf-8:utf-8\" bundle exec jekyll build",
    "serve": "npm run generate:gallery && npm run photos:fetch && npm run geocode && RUBYOPT=\"-E utf-8:utf-8\" bundle exec jekyll serve",
    "build:fast": "npm run photos:fetch && npm run geocode && RUBYOPT=\"-E utf-8:utf-8\" bundle exec jekyll build",
    "serve:fast": "npm run photos:fetch && npm run geocode && RUBYOPT=\"-E utf-8:utf-8\" bundle exec jekyll serve",
    "check:house-style": "python3 scripts/check-house-style.py",
    "check:important": "python3 scripts/check-important-ratchet.py",
    "check:js-sync": "python3 scripts/check-js-sync.py",
    "check:frontmatter": "node scripts/check-frontmatter.js",
    "check:gallery": "node scripts/check-gallery-integrity.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
